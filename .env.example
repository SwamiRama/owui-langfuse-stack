# Open WebUI + Langfuse v3 + Caddy POC Stack — environment template
# ====================================================================
# Copy to .env and fill in values:
#   cp .env.example .env
# Generate hex secrets in one go:
#   for k in WEBUI_SECRET_KEY NEXTAUTH_SECRET LANGFUSE_SALT ENCRYPTION_KEY \
#            PIPELINES_API_KEY REDIS_AUTH MINIO_ROOT_PASSWORD; do
#     echo "$k=$(openssl rand -hex 32)"
#   done

# === Domains (Caddy reverse proxy) =====================================
DOMAIN_OWUI=chat.example.com
DOMAIN_LANGFUSE=langfuse.example.com
OPENWEBUI_URL=https://chat.example.com
LANGFUSE_URL=https://langfuse.example.com
ACME_EMAIL=admin@example.com

# === Secrets (256-bit hex unless noted) ================================
# Generate each with: openssl rand -hex 32
WEBUI_SECRET_KEY=CHANGEME_64HEX
NEXTAUTH_SECRET=CHANGEME_64HEX
LANGFUSE_SALT=CHANGEME_64HEX
ENCRYPTION_KEY=CHANGEME_64HEX            # MUST be exactly 64 hex chars (256-bit)
PIPELINES_API_KEY=CHANGEME_64HEX
REDIS_AUTH=CHANGEME_64HEX

# Strong DB passwords (any printable string, but use a generator)
POSTGRES_PASSWORD=CHANGEME_STRONG_PASSWORD
CLICKHOUSE_PASSWORD=CHANGEME_STRONG_PASSWORD

# MinIO root user/password (used as S3 credentials by Langfuse)
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=CHANGEME_64HEX

# === LLM Provider ======================================================
# Get key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-CHANGEME

# === Open WebUI ========================================================
ENABLE_SIGNUP=true                       # set to false after first admin

# === Langfuse Headless Init ============================================
# These auto-create the org/project/admin on first start.
# REMOVE all LANGFUSE_INIT_* lines from .env after the first successful boot
# (avoid keeping plaintext admin password on disk).
#
# IMPORTANT: Langfuse v3 requires LANGFUSE_INIT_ORG_ID and
# LANGFUSE_INIT_PROJECT_ID to be set explicitly — leaving them empty
# silently skips the entire headless-init step.
#
# Generate IDs and project keys:
#   uuidgen | tr '[:upper:]' '[:lower:]'    # for ORG_ID and PROJECT_ID
#   PUBLIC_KEY="pk-lf-$(openssl rand -hex 16)"
#   SECRET_KEY="sk-lf-$(openssl rand -hex 32)"
LANGFUSE_INIT_ORG_ID=CHANGEME_UUID
LANGFUSE_INIT_PROJECT_ID=CHANGEME_UUID
LANGFUSE_INIT_ORG_NAME=Acme
LANGFUSE_INIT_PROJECT_NAME=Open WebUI
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_NAME=Admin
LANGFUSE_INIT_USER_PASSWORD=CHANGEME_STRONG_PASSWORD
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-CHANGEME
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-CHANGEME

# ============================================================
# === OPTIONAL: OAuth / SSO ==================================
# ============================================================
# Uncomment and fill in for Okta / Azure AD / Google / Authentik / etc.
# ENABLE_OAUTH_SIGNUP=true
# OAUTH_PROVIDER_NAME=Okta              # display name shown on login
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# OPENID_PROVIDER_URL=https://YOUR-TENANT/.well-known/openid-configuration
# OAUTH_SCOPES=openid email profile groups
#
# Auto-sync IdP groups → OWUI groups (requires `groups` claim in token)
# ENABLE_OAUTH_GROUP_MANAGEMENT=true
# OAUTH_GROUPS_CLAIM=groups
# ENABLE_OAUTH_GROUP_CREATION=false      # require pre-created OWUI groups
#
# Merge an OAuth login into an existing local account by email match
# OAUTH_MERGE_ACCOUNTS_BY_EMAIL=true
